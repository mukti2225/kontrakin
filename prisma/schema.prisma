generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Model untuk menyimpan data pengguna
model User {
  id               String    @id
  name             String
  email            String    @unique
  role             String    @default("tenant")
  registrationRole String    @default("tenant")
  banned           Boolean   @default(false)
  banReason        String?
  banExpires       DateTime?
  emailVerified    Boolean   @default(false)
  image            String?
  kodeUndangan     String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sessions         Session[]
  accounts         Account[]

  kamarDimiliki    Kamar[]     @relation("KamarOwner")
  penghuniDimiliki Penghuni[]  @relation("PenghuniOwner")
  penghuniProfil   Penghuni?   @relation("PenghuniUser")
  transaksi        Transaksi[] @relation("TransaksiOwner")
  propertiDimiliki Properti[]  @relation("PropertiOwner")

  @@index([role])
  @@index([banned])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

// Model untuk menyimpan data akun pengguna (misalnya akun Google, GitHub, dll.)
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// Model untuk menyimpan data kamar kontrakan
model Kamar {
  id           String      @id @default(cuid())
  nomor        String
  lantai       Int
  tipe         TipeKamar
  hargaBulanan Int
  status       StatusKamar @default(kosong)
  catatan      String?
  ownerId      String
  owner        User        @relation("KamarOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  propertiId   String?
  properti     Properti?   @relation("KamarProperti", fields: [propertiId], references: [id], onDelete: SetNull)
  penghuni     Penghuni[]
  transaksi    Transaksi[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([ownerId, nomor])
  @@index([propertiId])
}

enum StatusKamar {
  kosong
  terisi
  maintenance
}

enum TipeKamar {
  Standard
  Deluxe
  VIP
}

// Model untuk menyimpan data penghuni kontrakan
model Penghuni {
  id             String          @id @default(cuid())
  nama           String
  noHp           String
  email          String?
  noKtp          String?         @unique
  tanggalMasuk   DateTime
  tanggalKeluar  DateTime?
  status         StatusPenghuni  @default(aktif)
  catatan        String?

  ownerId       String
  owner         User            @relation("PenghuniOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  userId        String?         @unique
  user          User?           @relation("PenghuniUser", fields: [userId], references: [id])
  
  kamarId       String?
  kamar         Kamar?          @relation(fields: [kamarId], references: [id])
  transaksi     Transaksi[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("penghuni")
}

enum StatusPenghuni {
  aktif
  nonaktif
}

model Transaksi {
  id          String    @id @default(cuid())
  jenis       String
  kategori    String
  jumlah      Int
  tanggal     DateTime
  keterangan  String?
  kamarId     String?
  kamar       Kamar?    @relation(fields: [kamarId], references: [id])
  penghuniId  String?
  penghuni    Penghuni? @relation(fields: [penghuniId], references: [id])
  ownerId     String
  owner       User      @relation("TransaksiOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}

// Model untuk menyimpan data Properti (Kost, Kontrakan, Ruko)
model Properti {
  id          String         @id @default(cuid())
  nama        String
  tipe        TipeProperti
  alamat      String
  foto        String?
  lokasiMaps  String?
  fasilitas   String?
  deskripsi   String?
  
  ownerId     String
  owner       User           @relation("PropertiOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  kamar       Kamar[]        @relation("KamarProperti")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("properti")
}

enum TipeProperti {
  Kost
  Kontrakan
  Ruko
  Apartemen
}